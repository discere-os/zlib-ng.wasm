{
  "name": "@discere-os/zlib-ng.wasm",
  "version": "2.2.3",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "description": "Next-generation zlib-ng compression with advanced SIMD optimizations for Discere OS",
  "main": "dist/lib/index.js",
  "module": "dist/lib/index.js", 
  "types": "dist/lib/types.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/lib/index.js",
      "node": "./dist/lib/index.js",
      "types": "./dist/lib/types.d.ts"
    },
    "./side": {
      "import": "./install/wasm/zlib-ng-side.wasm",
      "types": "./dist/lib/types.d.ts"
    },
    "./main": {
      "import": "./install/wasm/zlib-ng-release.js",
      "types": "./dist/lib/types.d.ts"
    },
    "./fallback": {
      "import": "./install/wasm/zlib-ng-fallback.js",
      "types": "./dist/lib/types.d.ts"
    }
  },
  "scripts": {
    "build": "mkdir -p dist && tsc --project . --skipLibCheck && ./build-dual.sh all && mkdir -p build && cp install/wasm/* build/",
    "build:local": "mkdir -p dist && tsc --project . --skipLibCheck && ./build-dual.sh all && mkdir -p build && cp install/wasm/* build/",
    "build:wasm": "./build-dual.sh all",
    "build:ts": "tsc --project . --skipLibCheck",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --project . --noEmit --skipLibCheck",
    "demo": "node dist/demo.js",
    "benchmark": "node dist/benchmark.js",
    "benchmark:simd": "node dist/simd_benchmark.js",
    "clean": "./build-dual.sh clean && rm -rf dist build node_modules/.vite",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "zlib",
    "compression",
    "webassembly",
    "wasm",
    "simd",
    "deflate",
    "inflate",
    "crc32",
    "discere-os",
    "learning-os"
  ],
  "author": "Superstruct Ltd, New Zealand", 
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "https://github.com/discere-os/zlib-ng.wasm.git"
  },
  "homepage": "https://github.com/discere-os/zlib-ng.wasm",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist/",
    "install/",
    "src/",
    "build-dual.sh",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "cdn": {
    "primary": "https://wasm.discere.cloud/zlib-ng/",
    "fallbacks": [
      "https://cdn.jsdelivr.net/npm/@discere-os/zlib-ng.wasm/",
      "https://unpkg.com/@discere-os/zlib-ng.wasm/"
    ]
  }
}
